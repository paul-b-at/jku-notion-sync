# JKU k-number for Shibboleth login at https://my.jku.at
JKU_USER=

# JKU account password (same login as my.jku.at)
JKU_PASS=

# Notion internal integration token — create at https://www.notion.so/my-integrations
NOTION_TOKEN=

# Notion Deadlines database ID (32-char hex from the database URL)
NOTION_DEADLINES_DB=

# Notion Subjects database ID (32-char hex from the database URL)
NOTION_SUBJECTS_DB=

# Notion Exams database ID (32-char hex from the database URL)
NOTION_EXAMS_DB=

# Direct Moodle deadlines; set myjku only for an explicit legacy rollback.
TASK_SOURCE=moodle
